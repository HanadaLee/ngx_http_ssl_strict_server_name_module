ngx_addon_name=ngx_http_ssl_strict_server_name_module

if [ "$HTTP_SSL" != YES ]; then
    echo "$ngx_addon_name requires --with-http_ssl_module"
    exit 1
fi

have=NGX_HTTP_SSL_STRICT_SERVER_NAME . auto/have

if test -n "$ngx_module_link"; then
    ngx_module_type=HTTP
    ngx_module_name=ngx_http_ssl_strict_server_name_module
    ngx_module_order="$ngx_module_name ngx_http_realip_module"
    ngx_module_srcs="$ngx_addon_dir/ngx_http_ssl_strict_server_name_module.c"

    . auto/module
else
    HTTP_MODULES="$HTTP_MODULES ngx_http_ssl_strict_server_name_module"
    NGX_ADDON_SRCS="$NGX_ADDON_SRCS $ngx_addon_dir/ngx_http_ssl_strict_server_name_module.c"
fi

if [ "$ngx_module_link" != DYNAMIC -a "$HTTP_REALIP" = YES ]; then
    # Phase handlers run in reverse module order.
    HTTP_MODULES=`echo $HTTP_MODULES \
                  | sed "s/$ngx_addon_name//" \
                  | sed "s/ngx_http_realip_module/$ngx_addon_name ngx_http_realip_module/"`
fi
